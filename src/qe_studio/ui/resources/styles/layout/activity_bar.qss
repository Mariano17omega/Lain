/* Far-left activity bar (PRD §2.1.1). */
#activityBar {
    background: ${chrome};
    border-right: 1px solid ${border};
}
QToolButton[variant="activity"] {
    background: transparent;
    border: 1px solid transparent;  /* the focus ring (controls/focus.qss) takes this border */
    border-left: 2px solid transparent;
    border-radius: 4px;
    color: ${text_muted};
    font-size: 9px;
    padding: 3px 0 2px 0;
    min-width: ${activity_w};
    max-width: ${activity_w};
}
QToolButton[variant="activity"]:hover {
    background: ${hover};
    color: ${text};
}
QToolButton[variant="activity"]:checked {
    background: ${accent_soft};
    color: ${accent};
    border-left: 2px solid ${accent};
}
