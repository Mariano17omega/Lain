/* "Visualização 3D" window (spec 43): the status bar, the neighbour table and the texts of its
   panel. The scene itself is painted with its own colors (dark or light background), not tokens. */
#structureStatus {
    background: ${chrome};
    border-top: 1px solid ${border};
}
#structureStatus QLabel {
    padding: 0 6px;
}
#structureNeighbors {
    background: ${panel};
    color: ${text};
    border: 1px solid ${border};
    gridline-color: ${border};
}
#structureNeighbors QHeaderView::section {
    background: ${chrome};
    color: ${text_muted};
    border: none;
    border-bottom: 1px solid ${border};
    padding: 3px 6px;
    font-size: 11px;
}
#structureNeighbors::item {
    padding: 1px 6px;
}
QLabel[variant="meta"] {
    color: ${text_meta};
    font-size: 11px;
}
QLabel[variant="atomTitle"] {
    color: ${text};
    font-size: 12px;
    font-weight: 600;
}
