/* Clickable path in the top bar (spec 16 R1). */
#breadcrumb QToolButton[variant="crumb"] {
    font-family: "JetBrains Mono";
    font-size: 12px;
    color: ${text_secondary};
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 2px 6px;
}
#breadcrumb QToolButton[variant="crumb"]:hover {
    color: ${accent_text};
    background: ${hover};
}
#breadcrumb QToolButton[variant="crumb"][current="true"] {
    color: ${accent_text};
    background: ${accent_soft};
    border-color: ${accent_border};
}
#breadcrumb QToolButton[variant="crumb"]::menu-indicator {
    image: none;
}
#breadcrumb QLabel#crumbSeparator {
    font-family: "JetBrains Mono";
    font-size: 12px;
    color: ${text_meta};
    padding: 0 1px;
}
