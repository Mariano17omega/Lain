msgstr "#$ -pe: number of cores of the job"

#: core/calc_create/types/slab_fields.py
msgid "&CELL cell_dofree; '2Dxy' relaxa só o plano e a altura do vácuo não encolhe"
msgstr "&CELL cell_dofree; '2Dxy' relaxes only the plane, and the vacuum height does not shrink"

#: core/calc_create/types/vc_relax.py
msgid "&CELL press: pressão externa alvo, em kbar"
msgstr "&CELL press: target external pressure, in kbar"

