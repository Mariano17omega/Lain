msgid "&CONTROL etot_conv_thr, em Ry"
msgstr "&CONTROL etot_conv_thr, in Ry"

#: core/calc_create/types/relax.py
msgid "&CONTROL forc_conv_thr, em Ry/Bohr"
msgstr "&CONTROL forc_conv_thr, in Ry/Bohr"

#: core/calc_create/types/relax.py
msgid "&CONTROL nstep: número máximo de passos da otimização"
msgstr "&CONTROL nstep: maximum number of optimization steps"

#: core/calc_create/types/charge.py
msgid "&INPUTPP plot_num: 0 = densidade de carga eletrônica (pseudo)"
msgstr "&INPUTPP plot_num: 0 = electronic charge density (pseudo)"

#: core/calc_create/types/charge_diff.py
msgid ""
"&PLOT fileout dos quatro pp.x: <pasta>/<nome>.xsf. Relativa e dentro da pasta; o script cria a "
"pasta"
msgstr ""
"&PLOT fileout of the four pp.x: <folder>/<name>.xsf. Relative and inside the folder; the script "
"creates the folder"

#: core/calc_create/types/charge.py
msgid "&PLOT fileout: relativo e dentro da pasta; o script cria a pasta dele"
msgstr "&PLOT fileout: relative and inside the folder; the script creates its folder"

#: core/calc_create/types/charge.py
#, python-brace-format
msgid "&PLOT iflag: dimensão do gráfico; 3 = grade 3D{note}"
msgstr "&PLOT iflag: dimension of the plot; 3 = 3D grid{note}"

#: core/calc_create/types/charge.py
#, python-brace-format
msgid ""
"&PLOT output_format: 5 = XSF 3D para o XCrySDen (exige iflag = 3); o pp.x ignora o formato nos "
"gráficos 1D e polar{note}"
msgstr ""
"&PLOT output_format: 5 = 3D XSF for XCrySDen (requires iflag = 3); pp.x ignores the format in 1D "
"and polar plots{note}"

#: core/calc_create/types/pdos.py
msgid ""
"&SYSTEM occupations do NSCF (tetraedros dão uma DOS mais limpa; com tetraedros o projwfc.in sai "
"sem ngauss/degauss, e o projwfc.x usa o método dos tetraedros)"
msgstr ""
"&SYSTEM occupations of the NSCF (tetrahedra give a cleaner DOS; with tetrahedra projwfc.in is "
"written without ngauss/degauss, and projwfc.x uses the tetrahedron method)"

#: core/calc_create/types/surface_fields.py
#, python-brace-format
msgid "'{BOTTOM}': fixa os átomos abaixo desta fração da espessura (0.5 = metade)"
msgstr "'{BOTTOM}': fixes the atoms below this fraction of the thickness (0.5 = half)"

#: core/calc_create/types/surface_fields.py
#, python-brace-format
msgid ""
"'{BOTTOM}': os átomos abaixo da fração da espessura; '{SPECIES}': as espécies fixas e os vizinhos"
" ligados a elas; '{NONE}': todos livres"
msgstr ""
"'{BOTTOM}': the atoms below the fraction of the thickness; '{SPECIES}': the fixed species and the"
" neighbors bonded to them; '{NONE}': all free"

#: core/calc_create/types/surface_fields.py
#, python-brace-format
msgid "'{SPECIES}': rótulos de ATOMIC_SPECIES, separados por espaço"
msgstr "'{SPECIES}': ATOMIC_SPECIES labels, separated by spaces"

#: core/calc_create/types/surface_fields.py
#, python-brace-format
msgid "'{SPECIES}': rótulos dos vizinhos ligados às espécies fixas que também ficam fixos"
msgstr "'{SPECIES}': labels of the neighbors bonded to the fixed species that are also fixed"

