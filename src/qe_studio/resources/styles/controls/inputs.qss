/* Precision inputs: 22-24 px, JetBrains Mono numbers, cyan focus ring. */
QLineEdit, QDoubleSpinBox, QSpinBox, QComboBox {
    background: ${input};
    color: ${text};
    border: 1px solid ${border_strong};
    border-radius: 4px;
    padding: 2px 6px;
    min-height: 18px;
}
QDoubleSpinBox, QSpinBox {
    font-family: "JetBrains Mono";
    color: ${accent_text};
}
QLineEdit:focus, QDoubleSpinBox:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid ${accent};
}
QLineEdit:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    color: ${text_dim};
}
QLineEdit[variant="mono"] {
    font-family: "JetBrains Mono";
}
QComboBox::drop-down {
    border: none;
    width: 18px;
}
QComboBox::down-arrow {
    image: url(${icon_combo_arrow});
    width: 14px;
    height: 14px;
}
QComboBox QAbstractItemView {
    background: ${popover};
    border: 1px solid ${border_strong};
    selection-background-color: ${accent_soft};
    selection-color: ${accent_text};
    outline: none;
}
QCheckBox {
    spacing: 6px;
    color: ${text_secondary};
}
QCheckBox::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid ${border_strong};
    border-radius: 3px;
    background: ${input};
}
QCheckBox::indicator:checked {
    background: ${accent};
    border-color: ${accent};
}
QCheckBox::indicator:hover {
    border-color: ${accent};
}
QProgressBar {
    background: ${input};
    border: 1px solid ${border};
    border-radius: 3px;
    height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background: ${accent};
    border-radius: 3px;
}
QAbstractSpinBox {
    padding-right: 6px;
}
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    width: 0px;
    border: none;
}
