{% extends "qsub/_base.qsub.j2" %}
{% block programs %}
PROJWFCCOMMAND="/opt/espresso-7.1/bin/projwfc.x"
{% endblock %}
{% block body %}
{% for input, output in pw_runs %}
${MPICOMMAND} ${QE_COMMAND} -i "{{ input }}" > "{{ output }}"
check_step $? "{{ output }}"

{% endfor %}
${PROJWFCCOMMAND} -i "{{ projwfc[0] }}" > "{{ projwfc[1] }}"
check_step $? "{{ projwfc[1] }}"
{% endblock %}
{% block post %}

{# projwfc.x names its projections <filpdos>.pdos_atm#N(El)_wfc#M(l) and detection reads them from orbitals/. A glob on "wfc" would also move the input and output of projwfc.x. #}
mkdir -p orbitals
{# Every step passed when this runs: "Job done" must mail 0, also with no projection to move. #}
mv *pdos_atm#* orbitals/ 2>/dev/null || true
{% endblock %}
