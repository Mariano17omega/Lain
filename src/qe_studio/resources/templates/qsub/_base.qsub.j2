#!/bin/bash

# Path to installed versions of quantum espresso:
# /opt/espresso-6.1
# /opt/espresso-6.4.1
# /opt/espresso-6.5
# /opt/espresso-7.1
# /opt/espresso-7.3

### E-mail address to inform you about the start and the end of the job
MYEMAIL="{{ myemail }}"

###       Simulation setup          ###
# nk parameter
NK={{ nk }}

# QE executable
QE_COMMAND="/opt/espresso-7.1/bin/pw.x -nk $NK"
{% block programs %}{% endblock %}


# Input file
{% block inputs %}
{% for variable, name in inputs %}
{{ variable }}="{{ name }}"
{% endfor %}
{% endblock %}

###       Grid setup                   ###
#$ -N "{{ job_name }}"
#$ -pe physica {{ np }}
#$ -cwd -j y -notify

# Save worker nodes for debugging
cat "$PE_HOSTFILE"

###        Intel MPI and Mail setup             ###
export OMP_NUM_THREADS=1
export I_MPI_PIN_DOMAIN=core
source /opt/intel/oneapi/mkl/latest/env/vars.sh
source /opt/intel/oneapi/mpi/latest/env/vars.sh
source /opt/bin/sendmail.sh

# Hydra executable
MPICOMMAND="/opt/intel/oneapi/mpi/latest/bin/mpiexec -bootstrap ssh"

###		Start simulation			###
# Job started mail
sendMail "Running ..."

#########################################
# Run
#########################################

# Lain: the job ends at the first step that did not finish. pw.x leaves with status 0 and
# "JOB DONE." also when it stops early, so its own messages are read as well.
check_step() {  # check_step <status> <output>
    local status=$1
    if [ "$status" -eq 0 ] && grep -q "JOB DONE" "$2" && ! grep -q \
        -e "convergence NOT achieved" -e "Program stopped by user request" \
        -e "Maximum CPU time exceeded" -e "The maximum number of steps has been reached" \
        -e "bfgs failed" "$2"; then
        return 0
    fi
    [ "$status" -ne 0 ] || status=1
    echo "Job failed: $2 (status $status)"
    sendMail "Job failed: $2" "$status"
    exit 1
}


{% block body %}{% endblock %}
{% block post %}{% endblock %}


######################################### 

# Job finished mail
sendMail "Job done" "$?"

exit 0
