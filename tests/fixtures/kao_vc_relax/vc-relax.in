&control
    calculation = 'vc-relax'
    restart_mode='restart'
    prefix='kaolinite'
    pseudo_dir = '/home/alumni/mariano/PSEUDO/'
    outdir='./tmp'
    verbosity = 'low'
    etot_conv_thr = 1.0d-5
    forc_conv_thr = 1.0d-4
/
&system
  ibrav = 0
  ntyp = 4
  nat = 34
  occupations = 'fixed'
  vdw_corr = 'grimme-d3'
  ecutwfc = 90
  ecutrho = 360

/
&electrons
  conv_thr =   6.80d-08
  mixing_beta = 0.4
  electron_maxstep = 100
/
&ions
  ion_dynamics = 'bfgs'
/
&cell
  cell_dynamics = 'bfgs'
/
