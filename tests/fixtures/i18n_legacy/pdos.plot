# Lain: ajustes do gráfico. Gerado automaticamente; apague para voltar aos padrões.
lain_plot: 1
kind: pdos
params:
  title: ''
  figure_width: 6.0
  figure_height: 4.5
  font_size: 11.0
  background: '#ffffff'
  line_width: 1.2
  show_legend: true
  legend_loc: upper right
  legend_dx: 0.0
  legend_dy: 0.0
  legend_frame: false
  legend_size: null
  legend_transparency: 0.2
  tick_size: null
  label_size: null
  export_png: true
  export_svg: true
  export_pdf: true
  export_dpi: 600
  fermi_source: nscf
  shift_to_fermi: true
  emin: -5.0
  emax: 5.0
  dos_max: null
  grouping: species
  orientation: vertical
  show_total: true
  total_color: ''
  fill_occupied: true
  show_fermi_line: true
  fermi_color: '#f43f5e'
  hidden_series: []
  series_colors: {}
  orbital_colors:
    s: '#fbbf24'
    p: '#06b6d4'
    d: '#a855f7'
    f: '#ec4899'
  atomos_colors:
    Al: '#E41A1C'
    C: '#377EB8'
    H: '#4DAF4A'
    Hg: '#FF7F00'
    K: '#984EA3'
    O: '#228B22'
    Si: '#F781BF'
  legend_gap: false
  gap_method: homo_lumo
  spin_mode: mirror
