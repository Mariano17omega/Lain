# Lain: ajustes da visualização 3D, uma seção por arquivo. Gerado automaticamente; apague para voltar aos padrões.
lain_plot: 1
kind: view3d
params:
  scf.in:
    options:
      style: vareta
      radius_scale: 1.0
      bond_factor: 1.15
      show_bonds: true
      reps:
      - 2
      - 1
      - 1
      labels: indice
      label_size: 11
      show_cell: true
      show_abc: true
      show_xyz: true
      abc_width: 1.8
      xyz_width: 2.0
      perspective: true
      background: claro
      species_colors: {}
      species_hidden: []
