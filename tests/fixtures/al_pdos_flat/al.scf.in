 &control
    calculation = 'scf'
    prefix='al',
    pseudo_dir = '/home/m/Documentos/pseudo',
    outdir='./tmp'
 /

&SYSTEM
  ibrav= 2,
  celldm(1) = 7.63075,
  nat= 1,
  ntyp= 1,
  ecutwfc= 50,
  ecutrho= 500,
  
  occupations= 'smearing',
  smearing= 'gaussian',
  degauss= 0.01,
  
  nbnd = 30
/

&ELECTRONS
  conv_thr= 1e-8
/

ATOMIC_SPECIES
  Al 26.981539 Al.pbe-n-rrkjus_psl.1.0.0.UPF

ATOMIC_POSITIONS (alat)
  Al 0.00 0.00 0.00

K_POINTS (automatic)
  10 10 10 0 0 0
