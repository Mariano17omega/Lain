 &control
    calculation = 'bands'
    prefix='Fe',
    point_label_type='BI'
    pseudo_dir = '/home/seu_usuario/PSEUDO/',
    outdir='/home/seu_usuario/tmp/'
 /
 &system
    ibrav=  3,
    celldm(1) =5.42,
    nat=  1,
    ntyp= 1,
    nr1=27,
    nr2=27,
    nr3=27,
    noncolin=.true.
    lspinorb=.true.
    starting_magnetization(1)=0.5,
    occupations='smearing',
    smearing='mv',
    degauss=0.04,
    ecutwfc =45.0,
    ecutrho =300.0
 /
 &electrons
    conv_thr =  1.0d-10
    diagonalization = 'cg'
 /
