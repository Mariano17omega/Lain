&control
    calculation = 'scf',
    prefix='al',
    pseudo_dir = '/home/m/Documentos/pseudo',
    outdir='./tmp' 
/
&system
    ibrav=  2,
    celldm(1)=  7.630781648,
    ntyp= 1,
    nat=  1,
    ecutwfc = 100,
    ecutrho = 143,
    
    occupations= 'smearing',
    smearing= 'gaussian',
    degauss= 0.01
  
/
&electrons
    conv_thr =  1.0d-8
/
ATOMIC_SPECIES
 Al 26.981539 Al.pbe-n-rrkjus_psl.1.0.0.UPF

ATOMIC_POSITIONS
 Al 0.00 0.00 0.00

K_POINTS automatic
10 10 10 0 0 0

