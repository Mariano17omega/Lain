   calculation = 'scf'
   prefix='silicon',
   pseudo_dir='/home/docens/hidembergue/Pseudo/'
   outdir='./tmp'
   nstep = 100
   forc_conv_thr = 1.0D-6
/
&system
  ibrav = 14, 
  celldm(1) = 40.0,
  celldm(2) = 1.0,
  celldm(3) = 1.0, 
  celldm(4) = 0.0,
  celldm(5) = 0.0,
  celldm(6) = 0.0, 
  nat  = 5,
  ntyp = 3,
  ecutwfc = 90.0,
  
  vdw_corr='grimme-d2'

  occupations ='smearing',
  smearing ='gauss',
  degauss = 0.01, 

/
&electrons
  conv_thr =  1.0d-12
  mixing_beta=0.3
/
